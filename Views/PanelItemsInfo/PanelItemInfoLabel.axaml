<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:DravusSensorPanel.Views"
             xmlns:vm="clr-namespace:DravusSensorPanel.Views.PanelItemsInfo"
             x:DataType="vm:PanelItemInfoLabel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DravusSensorPanel.Views.PanelItemsInfo.PanelItemInfoLabel">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Margin="0, 10"
            Grid.Row="0"
            Orientation="Vertical" Spacing="30">

            <Grid ColumnSpacing="20" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    Description
                </TextBlock>

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Grid.ColumnSpan="7"
                         Text="{Binding PanelItem.Description,RelativeSource={RelativeSource AncestorType=vm:PanelItemInfoLabel}}" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    Label
                </TextBlock>
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="7"
                         Text="{Binding PanelItem.RawLabel,RelativeSource={RelativeSource AncestorType=vm:PanelItemInfoLabel}}" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    Preview
                </TextBlock>
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Grid.ColumnSpan="7"
                         IsReadOnly="True"
                         Text="{Binding PanelItem.Label,RelativeSource={RelativeSource AncestorType=vm:PanelItemInfoLabel}}" />

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    X
                </TextBlock>
                <NumericUpDown Grid.Row="3"
                               Grid.Column="1"
                               Increment="1"
                               Value="{Binding PanelItem.X, Converter={StaticResource NullBlocker}, RelativeSource={RelativeSource AncestorType=vm:PanelItemInfoLabel}}" />

                <TextBlock Grid.Row="3"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    Y
                </TextBlock>
                <NumericUpDown Grid.Row="3"
                               Grid.Column="3"
                               Increment="1"
                               Value="{Binding PanelItem.Y, Converter={StaticResource NullBlocker}, RelativeSource={RelativeSource AncestorType=vm:PanelItemInfoLabel}}" />

                <TextBlock Grid.Row="3"
                           Grid.Column="4"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    Z
                </TextBlock>
                <NumericUpDown Grid.Row="3"
                               Grid.Column="5"
                               Increment="1"
                               Maximum="9999998"
                               Value="{Binding PanelItem.ZIndex, Converter={StaticResource NullBlocker}, RelativeSource={RelativeSource AncestorType=vm:PanelItemInfoLabel}}" />

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    Font name
                </TextBlock>
                <views:FontPicker Grid.Row="4"
                                  Grid.Column="1"
                                  FontSelected="{Binding PanelItem.FontFamily, Mode=TwoWay,RelativeSource={RelativeSource AncestorType=vm:PanelItemInfoLabel}}" />

                <TextBlock Grid.Row="4"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    Font size
                </TextBlock>
                <NumericUpDown Grid.Row="4"
                               Grid.Column="3"
                               Increment="1"
                               Minimum="0"
                               Value="{Binding PanelItem.FontSize, Converter={StaticResource NullBlocker}, RelativeSource={RelativeSource AncestorType=vm:PanelItemInfoLabel}}" />

                <TextBlock Grid.Row="4"
                           Grid.Column="4"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    Text Alignment
                </TextBlock>
                <views:TextAlignmentPicker Grid.Row="4"
                                           Grid.Column="5"
                                           TextAlignmentSelected="{Binding PanelItem.TextAlignment, Mode=TwoWay,RelativeSource={RelativeSource AncestorType=vm:PanelItemInfoLabel}}" />

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    Font Color
                </TextBlock>
                <ColorPicker Grid.Row="5"
                             Grid.Column="1"
                             HorizontalAlignment="Left"
                             Color="{Binding PanelItem.Foreground, Mode=TwoWay,RelativeSource={RelativeSource AncestorType=vm:PanelItemInfoLabel}}" />

                <TextBlock Grid.Row="5"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    Transparency
                </TextBlock>
                <NumericUpDown Grid.Row="5"
                               Grid.Column="3"
                               Increment="1"
                               Minimum="0"
                               Maximum="100"
                               Value="{Binding PanelItem.Transparency, Converter={StaticResource NullBlocker}, RelativeSource={RelativeSource AncestorType=vm:PanelItemInfoLabel}}" />

                <TextBlock Grid.Row="5"
                           Grid.Column="4"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    Case style
                </TextBlock>
                <ComboBox Grid.Row="5"
                          Grid.Column="5"
                          Grid.ColumnSpan="3"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding CaseStyles, RelativeSource={RelativeSource AncestorType=vm:PanelItemInfoLabel}}"
                          SelectedValue="{Binding PanelItem.CaseStyle, RelativeSource={RelativeSource AncestorType=vm:PanelItemInfoLabel}}" />

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    Regex pattern
                </TextBlock>
                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         Text="{Binding PanelItem.ReplaceRegexPattern,RelativeSource={RelativeSource AncestorType=vm:PanelItemInfoLabel}}" />

                <TextBlock Grid.Row="6"
                           Grid.Column="4"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    Regex replace
                </TextBlock>
                <TextBox Grid.Row="6"
                         Grid.Column="5"
                         Grid.ColumnSpan="3"
                         Text="{Binding PanelItem.ReplaceRegexReplacement,RelativeSource={RelativeSource AncestorType=vm:PanelItemInfoLabel}}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
